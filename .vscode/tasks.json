{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SerialLedger: configure C/C++", "type": "process",
      "command": "${workspaceFolder}/.venv/Lib/site-packages/cmake/data/bin/cmake.exe",
      "args": ["--preset", "windows-msvc"],
      "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []
    },
    {
      "label": "SerialLedger: build C/C++", "type": "process",
      "command": "${workspaceFolder}/.venv/Lib/site-packages/cmake/data/bin/cmake.exe",
      "args": ["--build", "--preset", "windows-debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "SerialLedger: configure C/C++",
      "group": {"kind": "build", "isDefault": true}, "problemMatcher": "$msCompile"
    },
    {
      "label": "SerialLedger: test C/C++", "type": "process",
      "command": "${workspaceFolder}/.venv/Lib/site-packages/cmake/data/bin/ctest.exe",
      "args": ["--preset", "windows-debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "SerialLedger: build C/C++", "problemMatcher": []
    },
    {
      "label": "SerialLedger: test Python", "type": "process", "command": "uv",
      "args": ["run", "--locked", "python", "-m", "unittest", "discover", "-s", "tests/python", "-v"],
      "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []
    },
    {
      "label": "SerialLedger: demo", "type": "process", "command": "uv",
      "args": ["run", "--locked", "python", "-m", "serial_ledger", "demo"],
      "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []
    }
  ]
}
